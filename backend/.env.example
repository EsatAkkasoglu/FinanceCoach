# --- Required ---
GEMINI_API_KEY=your_gemini_api_key_here
NEWS_API_KEY=your_news_api_key_here
# CoinDesk Data API — all crypto data (spot, history, top-list, derivatives).
# Get a key at https://developers.coindesk.com/settings/api-keys
COINDESK_API_KEY=your_coindesk_api_key_here
# Derivatives venue for funding-rate / open-interest (binance | bybit | okex | ...)
COINDESK_FUTURES_MARKET=binance

# --- Recommended (free tier) ---
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=fincoach-hackathon

# --- Optional macro / context feeds (signals degrade gracefully without these) ---
# FRED (St. Louis Fed) — treasury yields + the 10y-2y curve for the macro regime.
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Finnhub — real-time US equity quotes + news backstop. Free 60/min:
# https://finnhub.io/dashboard
FINNHUB_API_KEY=
# (Crypto Fear & Greed is keyless — no config needed.)

# --- App config ---
FINCOACH_PORT=8765
FINCOACH_DB_PATH=./fincoach.db
FINCOACH_CHROMA_PATH=./chroma_db
FINCOACH_DEMO_MODE=false

# Gemini model selection — locked to 3.1 Flash-Lite (cheapest multimodal, $0.25/1M).
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_EXTRACT_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.3
